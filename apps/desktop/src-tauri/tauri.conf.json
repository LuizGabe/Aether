{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aether",
  "version": "0.2.0",
  "identifier": "com.aether.finance",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../../scripts/prepare-tauri.ps1",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aether",
        "width": 1380,
        "height": 900,
        "maximized": true,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/aether-api.jar"
    ]
  }
}
